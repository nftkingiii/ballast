{
  "name": "ballast",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/http.ts",
    "plan": "tsx src/cli.ts plan",
    "serve": "tsx src/http.ts",
    "mcp": "tsx src/mcp.ts",
    "record": "tsx scripts/record-fixtures.ts",
    "test": "tsx --test test/*.test.ts",
    "compare": "tsx compare/run.ts",
    "monitor": "tsx src/monitor-cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "tsx": "4.19.0",
    "viem": "2.21.0"
  },
  "devDependencies": {
    "@types/node": "22.7.0",
    "typescript": "5.6.2"
  }
}
